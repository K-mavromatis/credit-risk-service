# Copy this file to `.env` and fill in your real credentials.
# `.env` is git-ignored; `.env.example` is committed as a template.

# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/credit_scoring_db

# Optional tuning (defaults shown)
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- API: CORS (Sprint 3, Card 4) ---
# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Extra regex for local development (any port on localhost / 127.0.0.1).
# Leave empty to disable, e.g. in production: CORS_ORIGIN_REGEX=
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Frontend: scoring API client (Sprint 3, Card 5) ---
# Base URL of the FastAPI backend that the Streamlit UI calls (no trailing slash).
API_BASE_URL=http://localhost:8000
# Probability of default at or above which the UI shows "High default risk".
# Placeholder until a tuned threshold is chosen in notebook 03.
RISK_THRESHOLD=0.5
