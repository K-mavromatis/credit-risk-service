# =============================================================================
# Credit Risk Service - environment template
#
#   cp .env.example .env        # then edit .env; never commit it
#
# `.env` is git-ignored and excluded from Docker images (.dockerignore);
# docker compose injects it at runtime. This file holds placeholders only:
# NO real passwords, tokens or hostnames belong here.
#
# The placeholder values below are enough for a local `docker-compose up --build`
# demo. Change POSTGRES_PASSWORD for anything that is not your own laptop.
# =============================================================================

# --- PostgreSQL (db service + api connection) ---------------------- REQUIRED ---
# Compose refuses to start without POSTGRES_PASSWORD. The api container builds
# its DATABASE_URL from these three values with host `db`.
# Keep the password URL-safe (no @ : / ? #): it is embedded in a connection URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=credit_scoring_db

# --- Database URL for LOCAL runs only (uvicorn / alembic / pytest on the host) ---
# Ignored by docker compose, which overrides it for the api container.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/credit_scoring_db

# --- SQLAlchemy connection pool (optional, defaults shown) ---------------------
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- API: CORS (optional) ------------------------------------------------------
# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Extra origin regex for local development (any port on localhost / 127.0.0.1).
# Set it to an empty value to disable, e.g. in production: CORS_ORIGIN_REGEX=
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Frontend: scoring API client (optional) -----------------------------------
# Base URL of the FastAPI backend for the Streamlit UI (no trailing slash).
# Local runs only: docker compose sets it to http://api:8000 for the container.
API_BASE_URL=http://localhost:8000

# --- Credit decision (optional) ------------------------------------------------
# Probability of default at or above which an application is rejected.
# Shared by the API `decision`, the UI banner and scripts/evaluate_model.py.
# Must be strictly between 0 and 1. 0.5 is a placeholder until a tuned
# threshold is chosen (see README "Known limitations").
RISK_THRESHOLD=0.5
